      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT \n              SUBSTRING(p.title FROM 1 FOR 40) || '...' as \"Product\",\n              p.internal_sku as \"SKU\",\n              SUM(oi.quantity) as \"Units Sold\",\n              CAST(SUM(oi.total) as NUMERIC(10,2)) as \"Revenue\"\n            FROM order_items oi \n            JOIN channel_listings cl ON oi.channel_listing_id = cl.id \n            JOIN products p ON cl.product_id = p.id \n            JOIN orders o ON oi.order_id = o.id \n            GROUP BY p.id, p.title, p.internal_sku \n            ORDER BY SUM(oi.total) DESC \n            LIMIT 10"
        }
      ],
      "title": "Top Products by Revenue",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "afbksztd8e5mod"
