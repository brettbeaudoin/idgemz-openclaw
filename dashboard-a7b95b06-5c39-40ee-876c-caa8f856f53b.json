      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 5,
      "options": {
        "displayLabels": [
          "name",
          "percent"
        ],
        "legendDisplayMode": "list",
        "legendPlacement": "right",
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "unit": "currencyUSD"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT \n              c.name as channel,\n              CAST(SUM(o.order_total) as NUMERIC(10,2)) as revenue\n            FROM orders o \n            JOIN channels c ON o.channel_id = c.id \n            GROUP BY c.name\n            ORDER BY revenue DESC"
        }
      ],
      "title": "Sales by Channel",
      "type": "piechart"
    },
