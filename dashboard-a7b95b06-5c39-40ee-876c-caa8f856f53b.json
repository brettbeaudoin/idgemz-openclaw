      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT \n              DATE(order_date) AS time,\n              COALESCE(SUM(order_total), 0) AS revenue\n            FROM orders \n            WHERE order_date >= CURRENT_DATE - INTERVAL '30 days'\n            GROUP BY DATE(order_date)\n            ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Daily Revenue (Last 30 Days)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "afbksztd8e5mod"
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
