      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT \n              c.name as \"Channel\",\n              o.channel_order_id as \"Order ID\",\n              DATE(o.order_date) as \"Date\",\n              CAST(o.order_total as NUMERIC(10,2)) as \"Total\",\n              o.status as \"Status\"\n            FROM orders o \n            JOIN channels c ON o.channel_id = c.id \n            ORDER BY o.order_date DESC \n            LIMIT 20"
        }
      ],
      "title": "Recent Orders",
      "type": "table"
