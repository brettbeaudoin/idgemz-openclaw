{
  "id": "openclaw-memory-milvus",
  "name": "OpenClaw Memory Postgres",
  "description": "Recall canonical OpenClaw memory chunks from the local Postgres memory index.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "envPath": {
        "type": "string",
        "description": "Path to the memory-stack .env file."
      },
      "databaseUrl": {
        "type": "string",
        "description": "Postgres manifest database URL."
      },
      "hindsightBaseUrl": {
        "type": "string",
        "description": "Hindsight API base URL."
      },
      "hindsightBankId": {
        "type": "string",
        "description": "Hindsight bank id."
      },
      "hindsightTimeoutMs": {
        "type": "number",
        "description": "Hindsight recall timeout in milliseconds."
      },
      "rankingWeights": {
        "type": "object",
        "properties": {
          "vectorRrf": {
            "type": "number"
          },
          "looseLexicalRrf": {
            "type": "number"
          },
          "strictLexicalRrf": {
            "type": "number"
          },
          "distinctiveTerm": {
            "type": "number"
          },
          "phrase": {
            "type": "number"
          },
          "allDistinctiveTerms": {
            "type": "number"
          },
          "currentSource": {
            "type": "number"
          },
          "memorySource": {
            "type": "number"
          },
          "dailyMemorySource": {
            "type": "number"
          },
          "metaResultPenalty": {
            "type": "number"
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "memory_recall"
    ]
  }
}
