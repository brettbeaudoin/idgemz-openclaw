# OpenClaw memory stack local config. Copy to .env and fill only local secrets.

COMPOSE_PROJECT_NAME=openclaw-memory
OPENCLAW_MEMORY_NETWORK=openclaw-memory-net

# Manifest/index Postgres. Canonical truth remains the source files.
MEMORY_POSTGRES_PORT=55432
MEMORY_POSTGRES_DB=openclaw_memory
MEMORY_POSTGRES_USER=openclaw_memory
MEMORY_POSTGRES_PASSWORD=openclaw_memory_dev_password
MEMORY_DATABASE_URL=postgresql://openclaw_memory:openclaw_memory_dev_password@localhost:55432/openclaw_memory

# Hindsight.
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HINDSIGHT_POSTGRES_PORT=55434
HINDSIGHT_POSTGRES_DB=hindsight
HINDSIGHT_POSTGRES_USER=hindsight
HINDSIGHT_POSTGRES_PASSWORD=hindsight_dev_password
HINDSIGHT_API_PORT=8888
HINDSIGHT_DASHBOARD_PORT=9999
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=openclaw-v1
HINDSIGHT_API_KEY=

# Set these for fact extraction/consolidation. Do not commit real values.
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_MODEL=qwen3:1.7b
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_WORKER_MAX_SLOTS=1
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_RETAIN_LLM_TIMEOUT=300
HINDSIGHT_API_RETAIN_CHUNK_SIZE=1500
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=2048
# Native Ollama embedding path; all-minilm returns 384 dimensions, matching the
# Hindsight pgvector schema without the amd64-only TEI sidecar.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=litellm
HINDSIGHT_API_EMBEDDINGS_LITELLM_API_BASE=http://host.docker.internal:11434/v1
HINDSIGHT_API_EMBEDDINGS_LITELLM_MODEL=all-minilm:latest
HINDSIGHT_API_EMBEDDINGS_LITELLM_DIMENSIONS=384
HINDSIGHT_API_EMBEDDINGS_MAX_CONCURRENT_REQUESTS=1
MEMORY_CHUNK_RECIPE=file-span-v1/plain-v1/postgres-full-text

# Ingest source selection.
MEMORY_WORKSPACE_ROOT=/Users/bbeaudoin/clawd
MEMORY_INCLUDE_SESSION_LOGS=false
MEMORY_INCLUDE_PROJECT_DOCS=false
MEMORY_MAX_CHARS=1800
MEMORY_OVERLAP_LINES=4
MEMORY_PRIVACY_TAG=personal
